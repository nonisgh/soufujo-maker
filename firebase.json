{
  "hosting": {
    "site": "soufujo-maker-nonis",
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      "embed_rules.py",
      "送付テスト_*/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "fonts/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }] }
    ]
  }
}
